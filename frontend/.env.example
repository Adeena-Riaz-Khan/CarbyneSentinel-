# --- Local emulators (recommended for demos) ---
# cp .env.emulator .env.local
# See docs/EMULATORS.md
# VITE_USE_FIREBASE_EMULATOR=true
# VITE_FIREBASE_PROJECT_ID=carbynesentinel-local

# --- Cloud Firebase (optional) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: force Firestore data when on cloud
# VITE_USE_FIRESTORE_DATA=true

# Optional: comma-separated emails forced to security_admin
# VITE_FIREBASE_ADMIN_EMAILS=you@company.com

# Force mock auth/data (tests / offline UI)
# VITE_USE_MOCK_AUTH=true
